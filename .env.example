# AI-Powered Security Auditor - Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API (for embeddings and LLM reasoning)
OPENAI_API_KEY=sk-your-key-here

# NVIDIA NIM (optional - for NVIDIA model endpoints)
# NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1

# OWASP ZAP (optional - mock client available for testing)
# ZAP_API_KEY=your-zap-api-key
# ZAP_BASE_URL=http://localhost:8080

# FastAPI Server
API_HOST=0.0.0.0
API_PORT=8000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000
